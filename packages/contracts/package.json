{
  "name": "@humanmax/contracts",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Versioned contracts and schemas for HumanMax Agent Harness.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumanMaxAI/humanmax-harness.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/HumanMaxAI/humanmax-harness",
  "bugs": {
    "url": "https://github.com/HumanMaxAI/humanmax-harness/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "prepublishOnly": "npm run build"
  }
}
