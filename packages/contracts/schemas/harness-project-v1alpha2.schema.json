{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanmax.ai/harness/v1alpha2/harness-project.schema.json",
  "title": "HarnessProject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "humanmax.ai/harness/v1alpha2"
    },
    "kind": {
      "const": "HarnessProject"
    },
    "metadata": {
      "type": "object",
      "required": [
        "projectId",
        "owners"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "team"
            ],
            "properties": {
              "team": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "generator",
        "profiles",
        "autonomy",
        "runtime",
        "include",
        "exclude",
        "ci",
        "agentic"
      ],
      "properties": {
        "generator": {
          "type": "object"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "base"
          }
        },
        "autonomy": {
          "enum": [
            "read-only",
            "assisted",
            "bounded"
          ]
        },
        "runtime": {
          "type": "object",
          "required": [
            "defaultBudgets",
            "undeclaredEffect",
            "productionEnforcement",
            "enforcementAdapter"
          ],
          "properties": {
            "defaultBudgets": {
              "type": "object"
            },
            "undeclaredEffect": {
              "const": "deny"
            },
            "productionEnforcement": {
              "const": "unconfigured"
            },
            "enforcementAdapter": {
              "enum": [
                "local-review",
                "deny-all-production"
              ]
            }
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ci": {
          "type": "object"
        },
        "agentic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "capabilities"
          ],
          "properties": {
            "contractVersion": {
              "const": "1"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "const": "prompt"
                }
              ],
              "items": false
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
