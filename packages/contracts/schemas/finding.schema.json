{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://humanmax.ai/finding/v1alpha1/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "findingId",
    "ruleId",
    "result",
    "severity",
    "confidence",
    "subject",
    "evidence"
  ],
  "properties": {
    "apiVersion": { "const": "humanmax.ai/finding/v1alpha1" },
    "kind": { "const": "Finding" },
    "findingId": { "type": "string", "pattern": "^finding_[a-f0-9]{32}$" },
    "ruleId": { "type": "string", "minLength": 1 },
    "result": {
      "enum": ["PASS", "FAIL", "UNKNOWN", "NEEDS_HUMAN_REVIEW"]
    },
    "severity": {
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "confidence": {
      "enum": ["deterministic", "declared", "inferred", "unassessed"]
    },
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string" }
      }
    },
    "evidence": { "type": "array" },
    "governanceStatus": { "enum": ["open", "accepted-risk"] }
  }
}
