{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanmax.ai/harness/v1alpha2/prompt.schema.json",
  "title": "Prompt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "humanmax.ai/harness/v1alpha2"
    },
    "kind": {
      "const": "Prompt"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "instructions",
        "toolGuidance",
        "recovery",
        "variables",
        "examples",
        "output"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "toolGuidance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "required",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$"
              },
              "required": {
                "const": true
              },
              "source": {
                "const": "task"
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input",
              "output"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "object"
              }
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaRef"
          ],
          "properties": {
            "schemaRef": {
              "type": "string",
              "pattern": "^\\.humanmax/schemas/[A-Za-z0-9/_-]+\\.json$",
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
