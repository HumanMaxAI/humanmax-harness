{
  "name": "create-humanmax-agent",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Create a Preview HumanMax Agent Harness project (TypeScript tool-agent + base).",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumanMaxAI/humanmax-harness.git",
    "directory": "packages/create-humanmax-agent"
  },
  "homepage": "https://github.com/HumanMaxAI/humanmax-harness",
  "bugs": {
    "url": "https://github.com/HumanMaxAI/humanmax-harness/issues"
  },
  "bin": {
    "create-humanmax-agent": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/chmod-bin.mjs dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@humanmax/project-generator": "^0.1.0"
  }
}
